<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_bubble_ai.xml — Bong bóng chat của AI
    ────────────────────────────────────────────
    Bo góc bất đối xứng kiểu "đuôi bong bóng":
      - 3 góc bo lớn 24dp (topLeft, topRight, bottomRight)
      - Góc dưới trái bo nhỏ 4dp → tạo đuôi nhọn về phía avatar AI bên trái
    Màu xám sáng #F1F3F4, không viền cứng
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#F1F3F4" />
    <corners
        android:topLeftRadius="24dp"
        android:topRightRadius="24dp"
        android:bottomLeftRadius="4dp"
        android:bottomRightRadius="24dp" />
</shape>