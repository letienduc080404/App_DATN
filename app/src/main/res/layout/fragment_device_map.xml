<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_device_map.xml — Material Design 3 Premium
    ─────────────────────────────────────────────────────
    ViewBinding IDs giữ nguyên:
      - map_container   (FrameLayout vùng bản đồ)
      - rv_devices      (RecyclerView danh sách thiết bị)
      - progress_bar    (ProgressBar loading)
    Tỉ lệ: 60% map / 40% list (Guideline)
    Thiết kế Layered: map bo góc lớn dưới, list trượt lên trên
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/modern_background">

    <!-- ══════════════════════════════════════════
         PHẦN TRÊN: BẢN ĐỒ (60%) — Layered Card
         ══════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/map_card_wrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:cardCornerRadius="0dp"
        app:cardElevation="0dp"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.MapCardBottomRounded"
        app:strokeWidth="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/guideline_h60">

        <!-- FrameLayout bọc ngoài để chứa bản đồ và các overlay gradient/title -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/map_container"
                android:name="com.google.android.gms.maps.SupportMapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Gradient overlay phía trên để header title nổi bật -->
            <View
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:background="@drawable/bg_map_top_gradient"
                android:layout_gravity="top" />

            <!-- Header pill title -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="20dp"
                app:cardBackgroundColor="#CC1C1B1B"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@android:drawable/ic_menu_mylocation"
                        app:tint="#6DFFFFFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="BẢN ĐỒ VỊ TRÍ TRẠM"
                        android:textColor="@android:color/white"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gradient overlay phía dưới để tạo hiệu ứng layered chồng lên list -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:background="@drawable/bg_map_bottom_fade"
                android:layout_gravity="bottom" />

        </FrameLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Guideline 60% -->
    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline_h60"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.58" />

    <!-- ══════════════════════════════════════════
         PHẦN DƯỚI: DANH SÁCH THIẾT BỊ (42%)
         Nền trắng nổi lên, z-order trên map
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@color/modern_background"
        app:layout_constraintTop_toTopOf="@+id/guideline_h60"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Header phần danh sách -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="6dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Danh sách trạm"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tất cả thiết bị đang giám sát"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <!-- Badge tổng số -->
            <com.google.android.material.chip.Chip
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Xem tất cả"
                android:textSize="12sp"
                app:chipBackgroundColor="@color/accent_green_light"
                app:chipStrokeWidth="0dp"
                android:textColor="@color/agri_primary_green" />

        </LinearLayout>

        <!-- Đường phân cách mỏng -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="@color/card_stroke" />

        <!-- RecyclerView — ID giữ nguyên: rv_devices -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_devices"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:overScrollMode="never"
            android:scrollbars="none"
            tools:listitem="@layout/item_device" />

    </LinearLayout>

    <!-- ══════════════════════════════════════════
         LOADING STATE — MD3 Circular Indicator
         ══════════════════════════════════════════ -->
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="gone"
        app:indicatorColor="@color/agri_primary_green"
        app:trackColor="#E8F5E9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/guideline_h60"
        tools:visibility="gone" />

</androidx.constraintlayout.widget.ConstraintLayout>