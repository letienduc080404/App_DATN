<?xml version="1.0" encoding="utf-8"?>
<!--
    item_device.xml — Material Design 3 Premium Device Card
    ─────────────────────────────────────────────────────────
    ViewBinding IDs giữ nguyên 100% cho DeviceAdapter.java:
      - iv_device_icon      (ImageView icon trạm)
      - tv_device_name      (TextView tên trạm)
      - view_status_dot     (View chấm màu trạng thái)
      - tv_status_text      (TextView text trạng thái)
      - iv_battery          (ImageView icon pin)
      - tv_battery_percent  (TextView % pin)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/modern_card"
    app:cardCornerRadius="24dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- ── Left: Icon container hình tròn ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_icon_bg"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardBackgroundColor="@color/accent_green_light"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/iv_device_icon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_compass"
                app:tint="@color/agri_primary_green"
                tools:ignore="ContentDescription" />

        </com.google.android.material.card.MaterialCardView>

        <!-- ── Middle: Tên trạm + Chip trạng thái ── -->
        <LinearLayout
            android:id="@+id/layout_info"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="10dp"
            android:orientation="vertical"
            android:gravity="center_vertical"
            app:layout_constraintStart_toEndOf="@id/card_icon_bg"
            app:layout_constraintEnd_toStartOf="@id/layout_battery"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Tên thiết bị -->
            <TextView
                android:id="@+id/tv_device_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:ellipsize="end"
                android:text="Trạm đo 01"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Chip trạng thái kết nối (thay thế dot + text cũ) -->
            <!-- view_status_dot: giữ ID nhưng ẩn đi, chip là UI chính -->
            <View
                android:id="@+id/view_status_dot"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Chip trạng thái (bao gồm text tv_status_text bên trong) -->
            <LinearLayout
                android:id="@+id/chip_status_wrapper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_status_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp">

                <!-- Chấm trạng thái nhỏ bên trong chip -->
                <View
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:background="@drawable/bg_sensor_icon_circle"
                    android:backgroundTint="@color/agri_primary_green"
                    android:id="@+id/view_chip_dot" />

                <TextView
                    android:id="@+id/tv_status_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="Đang hoạt động"
                    android:textColor="@color/agri_primary_green"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    tools:text="Đang hoạt động" />

            </LinearLayout>

        </LinearLayout>

        <!-- ── Right: Pin (icon + %) ── -->
        <LinearLayout
            android:id="@+id/layout_battery"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Khung pin hình viên đạn -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="36dp"
                android:layout_height="36dp"
                app:cardBackgroundColor="@color/accent_green_light"
                app:cardCornerRadius="18dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <ImageView
                    android:id="@+id/iv_battery"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_lock_idle_low_battery"
                    app:tint="@color/agri_primary_green"
                    tools:ignore="ContentDescription" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Phần trăm pin -->
            <TextView
                android:id="@+id/tv_battery_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="85%"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>