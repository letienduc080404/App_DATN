<?xml version="1.0" encoding="utf-8"?>
<!--
    item_chat_ai.xml — Bong bóng tin nhắn AI
    ──────────────────────────────────────────
    ViewBinding ID giữ nguyên: tv_message
    Layout: avatar AI tròn bên trái, bong bóng căn trái
    Bong bóng: màu xám sáng #F1F3F4, góc bất đối xứng:
      - 3 góc bo 24dp (topLeft, topRight, bottomRight)
      - Góc dưới trái 4dp → đuôi bong bóng hướng về avatar AI
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="start"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="52dp"
    android:paddingTop="3dp"
    android:paddingBottom="3dp">

    <!-- Avatar AI tròn xanh nhạt -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="2dp"
        app:cardBackgroundColor="@color/accent_green_light"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/agri_primary_green"
        app:strokeWidth="1.5dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center"
            android:src="@android:drawable/ic_menu_view"
            app:tint="@color/agri_primary_green"
            android:contentDescription="AI" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Bubble container -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Label tên AI -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="2dp"
            android:text="AgriAI"
            android:textColor="@color/agri_primary_green"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.03" />

        <!-- Bong bóng tin nhắn AI xám nhạt -->
        <TextView
            android:id="@+id/tv_message"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_bubble_ai"
            android:lineSpacingMultiplier="1.4"
            android:maxWidth="260dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="11dp"
            android:paddingBottom="11dp"
            android:text="AI response"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <!-- Timestamp nhỏ dưới bubble -->
        <TextView
            android:id="@+id/tv_time_ai"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:layout_marginStart="4dp"
            android:text="14:30"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />

    </LinearLayout>

</LinearLayout>